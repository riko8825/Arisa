# Arisa in WonderDolls — environment variables template
# Copy to .env.local for local dev. NEVER commit .env files.
# Production values live in Vercel dashboard → Settings → Environment Variables.

# === Email (Resend) ===
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender email (must be verified domain in Resend)
RESEND_FROM=hello@arisainwonderdolls.com

# Where leads/reservations go
LEAD_INBOX=arisainwonderdolls@gmail.com

# === Per-endpoint auth secrets ===
# Generate each: openssl rand -hex 32
LEAD_CAPTURE_SECRET=
RESERVE_SECRET=
NEWSLETTER_SECRET=

# === AI (Phase 2) ===
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# === Site ===
SITE_URL=https://arisainwonderdolls.com
